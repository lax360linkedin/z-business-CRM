# ---------------------------------------------------------------------------------------------
# LAX360 Business CRM backend - environment configuration (placeholders only).
# Copy this file to `.env` and replace every value. NEVER commit `.env`.
# ---------------------------------------------------------------------------------------------

# --- Application ------------------------------------------------------------------------------
APP_NAME="LAX360 Business CRM API"
APP_ENV=development                # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma-separated list of origins the browser frontend is served from
CORS_ORIGINS=http://localhost:5173,http://localhost:5178

# --- Supabase PostgreSQL (SQLAlchemy 2.0 + psycopg 3) -----------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" string (or the direct string) and keep the `postgresql+psycopg://` prefix.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

# --- Supabase API (only for Supabase services such as Storage) --------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=crm-documents
# auto = Supabase Storage when configured, else the database; or force: supabase | database
STORAGE_BACKEND=auto

# --- Authentication (the backend issues its own JWT access tokens) ----------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- First Super Admin (used once by the seed script; change the password after first sign-in) -
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Sign people out after this many minutes of NO activity (5-480). The Super Admin can override it in Settings -> Security.
IDLE_TIMEOUT_MINUTES=30
