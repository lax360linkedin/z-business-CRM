# Copy to .env.local for local work; on Vercel set the same name under Project -> Settings -> Environment Variables.
#
# Where the API lives, WITHOUT a trailing slash and WITHOUT /api/v1 (the app adds that). Leave empty in development: the Vite dev server forwards /api to the backend.
# On Vercel this must be the public address of the deployed backend, e.g. https://your-api.onrender.com
# The backend must list this site's address in CORS_ORIGINS (and FRONTEND_URL).
VITE_API_URL=
# VITE_API_BASE_URL is accepted as an alias and, when both are set, wins.
